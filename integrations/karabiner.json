{
  "title": "Local Meet Pad: Meeting mode",
  "rules": [
    {
      "description": "Macropad: Left Control + Key 1 toggles Meeting mode",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "f16",
            "modifiers": {
              "mandatory": [
                "left_control"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "macropad_meeting_mode",
                "value": 0
              }
            },
            {
              "set_notification_message": {
                "id": "macropad_meeting_mode",
                "text": ""
              }
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 4489,
                  "product_id": 34960
                }
              ]
            },
            {
              "type": "variable_if",
              "name": "macropad_meeting_mode",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "f16",
            "modifiers": {
              "mandatory": [
                "left_control"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "macropad_meeting_mode",
                "value": 1
              }
            },
            {
              "set_notification_message": {
                "id": "macropad_meeting_mode",
                "text": "Macropad: Meeting mode ON"
              }
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 4489,
                  "product_id": 34960
                }
              ]
            },
            {
              "type": "variable_unless",
              "name": "macropad_meeting_mode",
              "value": 1
            }
          ]
        }
      ]
    },
    {
